# local development server settings
AUTH_DOMAIN = google.com
SERVER_NAME = 127.0.0.1
SERVER_PORT = 8080
# settings for OpenTelemetry in development
OTEL_SERVICE_NAME = gae-init-service-dev
OTEL_RESOURCE_ATTRIBUTES = deployment.environment.name=development
OTEL_PROPAGATORS = gcp_trace,tracecontext,baggage
OTEL_TRACES_SAMPLER = always_on
OTEL_TRACES_SAMPLER_ARG = 1.0
OTEL_TRACES_EXPORTER = none
OTEL_METRICS_EXPORTER = none
OTEL_LOGS_EXPORTER = none
# local Redis server settings (use HOST:PORT:DB:AUTH format)
REDIS_CONFIG = 127.0.0.1:6379:0:
# local datastore server settings
DEV_DATASTORE_HOST = 127.0.0.1
DEV_DATASTORE_PORT = 8081
# consider configuring this in your $HOME folder
DEV_DATASTORE_DIR = ./ds-data/
